# Пример переменных окружения. Скопируй в .env.local и заполни (файл .env.local в git не попадает).
# На Vercel эти же переменные задаются в Settings → Environment Variables
# (или подключаются автоматически при создании базы Turso и хранилища Blob через вкладку Storage).

# Адрес базы Turso: libsql://<имя-базы>-<аккаунт>.turso.io
# Для разработки без облака можно указать локальный файл: file:local.db
TURSO_DATABASE_URL=

# Токен доступа к базе Turso
TURSO_AUTH_TOKEN=

# Токен хранилища Vercel Blob (для загрузки треков)
BLOB_READ_WRITE_TOKEN=
